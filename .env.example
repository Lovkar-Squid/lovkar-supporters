# Copy this file to ".env" and fill in the values. Never commit the real .env.

# Admin token for the supporter admin UI (any long random string).
# The admin page at / asks for this before it will add/remove supporters.
ADMIN_TOKEN=change-me-to-a-long-random-secret

# Cloudflare Tunnel token (from the Zero Trust dashboard -> Networks -> Tunnels).
# Leave blank if you are not exposing the service through Cloudflare yet.
TUNNEL_TOKEN=
