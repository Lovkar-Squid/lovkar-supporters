# Copy this file to ".env" and fill in the values. Never commit the real .env.

# Admin token for the supporter admin UI (any long random string).
ADMIN_TOKEN=change-me-to-a-long-random-secret

# Cloudflare Tunnel token (from the Zero Trust dashboard -> Networks -> Tunnels).
TUNNEL_TOKEN=

# --- Patreon auto-linking (optional; linking stays off until CLIENT_ID + SECRET are set) ---
# Create a Patreon OAuth client at https://www.patreon.com/portal/registration/register-clients
#   Redirect URI: https://supporters.lovkarsquid.com/link/callback
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
# Webhook secret from Patreon -> your webhook (https://supporters.lovkarsquid.com/webhook/patreon)
PATREON_WEBHOOK_SECRET=
# Public base URL this service is reachable at (used to build the OAuth redirect)
PUBLIC_BASE_URL=https://supporters.lovkarsquid.com
